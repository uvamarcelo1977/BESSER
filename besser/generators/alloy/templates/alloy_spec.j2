{% macro strname(n) -%}
{{ "Str" if n == "str" else ("Date" if n == "date" else n) }}
{%- endmacro -%}
open util/boolean
{% if "int" in basic_signatures or "float" in basic_signatures %}
open util/integer
{% endif %}
{% if has_date_values %}
open util/ordering[Date]
{% endif %}

-- Basic signatures
{% for tipo in basic_signatures %}
{% if tipo not in ['bool', 'int', 'float', 'date'] %}
sig {{ strname(tipo) }} {}
{% endif %}
{% endfor %}
{% if has_date_values %}
sig Date {}
{% endif %}

{% if enum_types %}
-- Enumerations
{% for e in enum_types %}
{% set literals = [] %}
{% for v in e.literals %}
{% do literals.append("ENUM_" ~ e.name ~ "_" ~ v.name) %}
{% endfor %}
abstract sig {{ e.name }} {}
one sig {{ literals | join(', ') }} extends {{ e.name }} {}
{% endfor %}
{% endif %}

-- Helper functions
{% raw %}
fun image [s: univ -> univ]: set univ { { f: univ | some i: univ | i -> f in s } }

fun toSeq [a: set univ, rel: univ -> univ]: univ -> univ { a <: rel }
fun collect [s: univ -> univ, r: univ -> univ]: univ -> univ { s.r }
{% endraw %}

{% if date_block %}
{{ date_block }}
{% endif %}

{% macro alloy_model(class_obj, associations) %}
{% if class_obj.name not in ['Integer', 'String'] %}
{% set lines = [] %}
{# --- 1. Mapeo de atributos --- #}
{% for attr in class_obj.attributes %}
  {% set typename = "Int" if (attr.type.name in ["int", "float", "integer"]) else ("Bool" if attr.type.name == "bool" else ("Date" if attr.type.name in ("date", "datetime", "time", "timedelta") else strname(attr.type.name))) %}
  {% do lines.append(class_obj.name ~ "_" ~ attr.name ~ ": " ~ typename) %}
{% endfor %}
{# --- 2. Mapeo de asociaciones --- #}
{% for association in associations if association.ends | length == 2 %}
  {% set ends_list = association.ends | list %}
  {% set e1 = ends_list[0] %}
  {% set e2 = ends_list[1] %}
  {# Relaciones reflexivas #}
  {% if e1.type.name == class_obj.name and e2.type.name == class_obj.name %}
    {% for end_ref in ends_list if end_ref.is_navigable %}
      {% set typename = "Int" if end_ref.type.name | lower in ['integer', 'int', 'float'] else strname(end_ref.type.name) %}
      {% set mult = "lone " if (end_ref.multiplicity.min == 0 and end_ref.multiplicity.max == 1) else ("set " if end_ref.multiplicity.max > 1 else "one ") %}
      {% do lines.append(class_obj.name ~ "_" ~ end_ref.name ~ ": " ~ mult ~ typename) %}
    {% endfor %}
  {# Relaciones normales #}
  {% else %}
    {% set target_end = e2 if e1.type.name == class_obj.name else (e1 if e2.type.name == class_obj.name else None) %}
    {% if target_end and target_end.is_navigable %}
      {% set typename = "Int" if target_end.type.name | lower in ['integer', 'int', 'float'] else strname(target_end.type.name) %}
      {% set mult = "lone " if (target_end.multiplicity.min == 0 and target_end.multiplicity.max == 1) else ("set " if target_end.multiplicity.max > 1 else "one ") %}
      {% do lines.append(class_obj.name ~ "_" ~ target_end.name ~ ": " ~ mult ~ typename) %}
    {% endif %}
  {% endif %}
{% endfor %}
{# --- 3. Encabezado de la signature --- #}
{% if class_obj.parents() %}
  {% if class_obj.parents() | length > 1 %}
    {% set header = "sig " ~ class_obj.name ~ " in " ~ (class_obj.parents() | map(attribute='name') | join(' + ')) %}
  {% else %}
    {% set header = "sig " ~ class_obj.name ~ " extends " ~ (class_obj.parents() | list | first).name %}
  {% endif %}
{% else %}
  {% set header = ("abstract sig " ~ class_obj.name) if class_obj.is_abstract else ("sig " ~ class_obj.name) %}
{% endif %}
{% if lines | length == 0 %}
{{ header }} {}
{% else %}
{{ header }} {
{% for line in lines %}
  {{ line }}{{ "," if not loop.last else "" }}
{% endfor %}
}
{% endif %}
{% endif %}
{% endmacro %}

-- Classes
{% for class_obj in classes %}
{{ alloy_model(class_obj, associations_by_class.get(class_obj.name, [])) }}
{% endfor %}

{% if constraints %}
-- Constraints
{% for c in constraints %}
{{ c.expression }}
{% endfor %}
{% endif %}

{% set valid_sigsnv = [] %}
{% for sig in sigsnv | unique %}
  {% if sig not in ['bool', 'int', 'float', 'Integer'] %}
    {% do valid_sigsnv.append(sig) %}
  {% endif %}
{% endfor %}

{% if facts_rules %}
{% for f in facts_rules %}
{{ f }}
{% endfor %}
{% endif %}

pred instance_model {
{% for sig in valid_sigsnv %}
  some {{ strname(sig) }}
{% endfor %}
}

run instance_model for {% for sig in valid_sigsnv %}{{ scope }} {{ strname(sig) }}{{ ", " if not loop.last else "" }}{% endfor %}

